{
  "name": "admin",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:seed": "wrangler d1 execute DB --file ../../packages/db/seed.sql",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:tsc": "tsc --noEmit",
    "lint:oxlint": "oxlint .",
    "fmt": "pnpm run \"/^fmt:/\"",
    "fmt:oxfmt": "oxfmt --write ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.1",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@cloudflare/vite-plugin": "1.64.0",
    "@packages/db": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@vitejs/plugin-react": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.4"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
