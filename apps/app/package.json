  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "cf:set-env": "bash scripts/set-secrets.sh .env.production",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:tsc": "tsc --noEmit",
