{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:base",
    ":timezone(Asia/Tokyo)",
    "local>junkisai/nextjs-template//renovate/groupLinters.json5",
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  // pnpm-workspace.yaml の minimumReleaseAge: 10080（分）と同じ長さ。
  // ここが短いと、pnpm がインストールを拒否する版の PR が立つ
  minimumReleaseAge: "7 days",
  vulnerabilityAlerts: {
    labels: ["security"],
  },
}
