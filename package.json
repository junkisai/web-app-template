{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "gen": "turbo run gen",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:knip",
    "lint:knip": "SKIP_ENV_VALIDATION=1 knip",
    "lint:packageVersion": "syncpack list-mismatches",
    "fmt": "turbo run fmt",
    "sync:agents": "bash scripts/sync-agent-config.sh"
  },
  "devDependencies": {
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.77.0",
    "syncpack": "13.0.4",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
