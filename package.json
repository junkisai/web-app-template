{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "gen": "turbo run gen",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:knip",
