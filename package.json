    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "syncpack": "15.3.3",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  }
}
